# ══════════════════════════════════════════════════════════════════════════
# Neural Service Mesh (NSM) — قالب متغيرات البيئة
# ══════════════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env (محلياً) أو أضف القيم كـ Secrets في Streamlit
# Community Cloud (Settings → Secrets). لا تضع أي قيمة حقيقية هنا في هذا
# الملف نفسه — هذا قالب توثيقي فقط، القيم الفعلية تبقى سرّية دائماً.
#
# كل متغير هنا مُستخرَج مباشرة من استدعاءات os.getenv()/os.environ.get()
# الفعلية في الكود (وليس تخميناً) — راجع "المصدر" أمام كل واحد لو احتجت
# التأكد بنفسك.
# ══════════════════════════════════════════════════════════════════════════


# ─── مزوّدو LLM (ai/llm_fallback.py — سلسلة fallback للصياغة اليمنية وغيرها) ─
# لا حاجة لكل هذه المفاتيح معاً — واحد على الأقل يكفي لتفعيل LLMFallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GOOGLE_API_KEY=
# Cloudflare Workers AI — يحتاج الاثنين معاً
CF_ACCOUNT_ID=
CF_API_TOKEN=


# ─── تدريب الشبكة اليمنية (train_yemeni.py) — كلها اختيارية، لها قيم افتراضية ─
YEMENI_DATA_PATH=data/yemeni_instructions.json
YEMENI_WEIGHTS_DIR=models/yemeni_decoder
YEMENI_LOSS_LOG=memory/training_loss.json
YEMENI_EPOCHS=4
YEMENI_LR=1e-3
YEMENI_LORA_RANK=8
YEMENI_LORA_ALPHA=16.0
YEMENI_MAX_LEN=96
YEMENI_BATCH_SIZE=4


# ─── تدريب CKG (train_batch.py) — كلها اختيارية، لها قيم افتراضية ───────────
CKG_WEIGHTS_DIR=models/transformer_ckg_v1
CKG_STATE_FILE=ckg_train_state.json
CKG_SENTENCES_FILE=ckg_sentences.pkl
CKG_BATCH_SIZE=300


# ─── رفع تلقائي لـ GitHub من داخل التطبيق (ai/github_sync.py) ───────────────
# مطلوبة فقط لو أردت أن يستطيع NSM نفسه عمل commit/push لتغييراته (مثلاً
# CKG محدَّث) من داخل Streamlit Cloud تلقائياً. بدونها: هذه الميزة تُعطَّل
# بصمت (لا كسر)، ويظهر تنبيه "GITHUB_TOKEN or GITHUB_REMOTE not set".
GITHUB_TOKEN=
# أو استخدم هذا بديلاً (نفس الغرض، اسم أقدم يُقرأ أولاً كـ fallback):
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_USER=
GITHUB_REMOTE=


# ─── اتصال Streamlit بخدمة Agent API ────────────────────────────────────────
# محلياً: http://127.0.0.1:5000
# في الإنتاج: عنوان نشر api_server.py على Vercel أو أي خدمة FastAPI.
NSM_API_URL=https://world-cup-2026-fun-guide.vercel.app

# ─── لوحة الإدارة + مهام الوكيل (streamlit_app.py / api_server.py) ──────────
# مفتاح دخول لوحة التحكم الإدارية، ومصادقة /api/agent/tasks.
# اتركه فارغاً لتعطيل اللوحة ومسار المهام المحمي بهذا المفتاح.
NSM_ADMIN_KEY=

# ─── واجهة API العامة (api_server.py: /process ونقاط X-API-Key) ──────────────
# مفتاح مصادقة هيدر x-api-key. اتركه فارغاً لتعطيل الـendpoints (fail-closed).
# على Vercel (nsm-agent-api): اجعل NSM_API_KEY = NSM_ADMIN_KEY بنفس القيمة
# ثم Redeploy — وإلا سيظهر 403 عند اختلاف السر بين Deployment والعميل.
NSM_API_KEY=


# ─── مصادر الصور التوضيحية (ai/image_sources.py, ai/image_search_tool.py) ──
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# ملاحظة: Openverse (المصدر الاحتياطي في image_sources.py) لا يحتاج مفتاحاً


# ─── الصوت (ai/tts_engine.py) ────────────────────────────────────────────────
ELEVENLABS_API_KEY=


# ─── Higgsfield (ai/higgsfield_engine.py) ────────────────────────────────────
HIGGSFIELD_API_KEY=


# ─── قاعدة المتجهات Qdrant (ai/vector_backend.py) ────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=


# ─── نشر مغلق بدون إنترنت خارجي (ai/llm_fallback.py, ai/offline_mode.py) ─────
# التفصيل الكامل: OFFLINE_DEPLOYMENT.md
NSM_OFFLINE_MODE=
NSM_LOCAL_LLM_URL=
NSM_LOCAL_MODEL=


# ─── Upstash Redis (whatsapp_gateway/lib/accounts_lookup.py) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── WhatsApp Business API ───────────────────────────────────────────────────
# مستخدَمة في مسارين: whatsapp_gateway/lib/whatsapp_client.py (البوابة
# المستقلة) و ai/social_platforms/whatsapp_adapter.py (Social Agent)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=


# ─── Discord (ai/social_platforms/discord_adapter.py) ────────────────────────
DISCORD_BOT_USER_ID=


# ─── LinkedIn (ai/social_platforms/linkedin_adapter.py) ─────────────────────
LINKEDIN_API_VERSION=202401


# ─── Social Agent (ai/social_agent.py) ──────────────────────────────────────
SOCIAL_AGENT_MODEL=


# ─── Kaggle (ai/kaggle_provider.py) ──────────────────────────────────────────
# للتدريب عبر Kaggle API (Kernels على Dual T4) دون فتح متصفح.
# 1) من kaggle.com/settings → Create New Token → kaggle.json
# 2) ضعه في ~/.kaggle/kaggle.json أو صدّر:
KAGGLE_USERNAME=
KAGGLE_KEY=
# مسار مخصص اختياري لملف kaggle.json:
# NSM_KAGGLE_JSON=/path/to/kaggle.json
# KAGGLE_CONFIG_DIR=/path/to/dir_containing_kaggle_json
#
# أوامر الوكيل: حالة kaggle · جهّز kaggle · ادفع kaggle <job_id>
# الدليل: notebooks/README_KAGGLE.md
