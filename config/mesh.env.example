# قالب أسرار التشغيل الدائم — انسخه إلى .env.mesh (غير متتبَّع) وضع قيمك الحقيقية.
# لا تضع أسراراً حقيقية في هذا الملف المتتبَّع.
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GITHUB_TOKEN=
HIGGSFIELD_API_KEY=
# اختياري: الجسر اليدوي (NSM_CLAUDE_BRIDGE=1) — الأجوبة تتطلب مجيباً بشرياً/Claude نشطاً.
NSM_CLAUDE_BRIDGE=0
# اختياري: عدد العقد (1..28) وترتيب نماذج البرمجة.
# NSM_NODE_COUNT=28
# NSM_CODE_MODELS=Qwen/Qwen3-Coder-480B-A35B-Instruct,Qwen/Qwen3-Coder-30B-A3B-Instruct

# نموذج مفتوح الأوزان محلي (اختياري، الأعلى أولوية عند ضبطه): شغّل
